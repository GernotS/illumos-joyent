From 2460e27dad9a072e824e12b8cf4d7b7b9c93cd66 Mon Sep 17 00:00:00 2001
From: Gernot Strasser <gernot1.strasser@gmail.com>
Date: Fri, 9 Oct 2026 08:02:56 +0000
Subject: [PATCH 92/93] fdt: libzfs: report EALREADY from zpool ddtprune
 instead of aborting

ddt_prune_unique_entries() returns EALREADY when another prune of the
pool is running.  zpool_standard_error() has no case for it, so it is
reported as EZFS_UNKNOWN, which prints "internal error" and calls
abort(): a second `zpool ddtprune` dumps core.

Map it in zpool_ddt_prune() to EZFS_BUSY with "a prune operation is
already in progress".

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 usr/src/lib/libzfs/common/libzfs_pool.c | 9 +++++++++
 1 file changed, 9 insertions(+)

diff --git a/usr/src/lib/libzfs/common/libzfs_pool.c b/usr/src/lib/libzfs/common/libzfs_pool.c
index a37d3b57..896aaf3a 100644
--- a/usr/src/lib/libzfs/common/libzfs_pool.c
+++ b/usr/src/lib/libzfs/common/libzfs_pool.c
@@ -2231,6 +2231,15 @@ zpool_ddt_prune(zpool_handle_t *zhp, zpool_ddt_prune_unit_t unit,
 	if (ret != 0) {
 		(void) snprintf(msg, sizeof (msg), dgettext(TEXT_DOMAIN,
 		    "cannot prune DDT on '%s'"), zhp->zpool_name);
+		/*
+		 * EALREADY is not handled by zpool_standard_error(), which
+		 * would report it as EZFS_UNKNOWN and abort().
+		 */
+		if (errno == EALREADY) {
+			zfs_error_aux(hdl, dgettext(TEXT_DOMAIN,
+			    "a prune operation is already in progress"));
+			return (zfs_error(hdl, EZFS_BUSY, msg));
+		}
 		(void) zpool_standard_error(hdl, errno, msg);
 		return (-1);
 	}
