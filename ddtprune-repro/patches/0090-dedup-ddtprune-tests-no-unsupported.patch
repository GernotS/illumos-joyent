@@ -155,13 +185,13 @@
 typeset -i prune_rc=$?
 
 log_must rm $stopfile
-kill $dtrace_pid 2>/dev/null
+[[ -n $dtrace_pid ]] && kill $dtrace_pid 2>/dev/null
