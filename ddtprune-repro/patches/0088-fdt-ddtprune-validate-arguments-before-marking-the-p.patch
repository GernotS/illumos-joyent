From c251097a82fb57b6c0f8288c8a930b09dfc2130b Mon Sep 17 00:00:00 2001
From: Kamil Monicz <kamil@monicz.dev>
Date: Fri, 9 Oct 2026 08:02:16 +0000
Subject: [PATCH 88/93] fdt: ddtprune: validate arguments before marking the
 prune active

ddt_prune_unique_entries() marks the pool's prune active before it
validates the request.  Validate the unit, the percentage (1-100) and
the age (not before the epoch) first, so a rejected request never
touches spa_active_ddt_prune.

zpool ddtprune converts days to seconds without checking for overflow,
so a large enough value wraps to a small age and prunes recent entries.
Reject values that do not fit.

The illumos port already cleared the mark on its EINVAL paths and the
ioctl already rejected bad percentages; this aligns the code with
upstream.

Ported from openzfs/zfs#19263 (aaf1698, not yet merged upstream).

Signed-off-by: Kamil Monicz <kamil@monicz.dev>
---
 usr/src/cmd/zpool/zpool_main.c  |  3 ++-
 usr/src/uts/common/fs/zfs/ddt.c | 22 ++++++++++++----------
 2 files changed, 14 insertions(+), 11 deletions(-)

diff --git a/usr/src/cmd/zpool/zpool_main.c b/usr/src/cmd/zpool/zpool_main.c
index 8070317b..65d539ae 100644
--- a/usr/src/cmd/zpool/zpool_main.c
+++ b/usr/src/cmd/zpool/zpool_main.c
@@ -6793,7 +6793,8 @@ zpool_do_ddt_prune(int argc, char **argv)
 			}
 			errno = 0;
 			amount = strtoull(optarg, &endptr, 0);
-			if (errno != 0 || *endptr != '\0' || amount == 0) {
+			if (errno != 0 || *endptr != '\0' || amount == 0 ||
+			    amount > UINT64_MAX / 86400) {
 				(void) fprintf(stderr,
 				    gettext("invalid days value\n"));
 				usage(B_FALSE);
diff --git a/usr/src/uts/common/fs/zfs/ddt.c b/usr/src/uts/common/fs/zfs/ddt.c
index a45e01eb..38590e41 100644
--- a/usr/src/uts/common/fs/zfs/ddt.c
+++ b/usr/src/uts/common/fs/zfs/ddt.c
@@ -2824,6 +2824,17 @@ ddt_prune_unique_entries(spa_t *spa, zpool_ddt_prune_unit_t unit,
 {
 	uint64_t cutoff;
 	uint64_t start_time = gethrtime();
+	uint64_t now = gethrestime_sec();
+
+	if (unit == ZPOOL_DDT_PRUNE_PERCENTAGE) {
+		if (amount == 0 || amount > 100)
+			return (SET_ERROR(EINVAL));
+	} else if (unit == ZPOOL_DDT_PRUNE_AGE) {
+		if (amount >= now)
+			return (SET_ERROR(EINVAL));
+	} else {
+		return (SET_ERROR(EINVAL));
+	}
 
 	if (spa->spa_active_ddt_prune)
 		return (SET_ERROR(EALREADY));
@@ -2835,8 +2846,6 @@ ddt_prune_unique_entries(spa_t *spa, zpool_ddt_prune_unit_t unit,
 	zfs_dbgmsg("prune %llu %s", (u_longlong_t)amount,
 	    unit == ZPOOL_DDT_PRUNE_PERCENTAGE ? "%" : "seconds old or older");
 
-	uint64_t now = gethrestime_sec();
-
 	if (unit == ZPOOL_DDT_PRUNE_PERCENTAGE) {
 		ddt_age_histo_t histogram;
 		uint64_t oldest = 0;
@@ -2861,15 +2870,8 @@ ddt_prune_unique_entries(spa_t *spa, zpool_ddt_prune_unit_t unit,
 			}
 		}
 		cutoff = now - oldest;
-	} else if (unit == ZPOOL_DDT_PRUNE_AGE) {
-		if (amount >= now) {
-			spa->spa_active_ddt_prune = B_FALSE;
-			return (SET_ERROR(EINVAL));
-		}
-		cutoff = now - amount;
 	} else {
-		spa->spa_active_ddt_prune = B_FALSE;
-		return (SET_ERROR(EINVAL));
+		cutoff = now - amount;
 	}
 
 	if (cutoff > 0 && !spa_shutting_down(spa) && !issig(JUSTLOOKING)) {
-- 
