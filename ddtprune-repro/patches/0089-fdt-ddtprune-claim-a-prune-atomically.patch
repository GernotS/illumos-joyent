From 98f02119b8297c495e18cb2cfd8a50a84d52e673 Mon Sep 17 00:00:00 2001
From: Kamil Monicz <kamil@monicz.dev>
Date: Fri, 9 Oct 2026 08:02:17 +0000
Subject: [PATCH 89/93] fdt: ddtprune: claim a prune atomically

ddt_prune_unique_entries() tests spa_active_ddt_prune on entry but sets
it only after reading the dedup table statistics.  Two prunes of the
same pool can both pass the test and walk the table together.  The
first to finish clears the mark while the other is still pruning, so
that prune's sync tasks lose the SCL_ZIO priority that
zio_vdev_io_start() gives them against a waiting config writer.

Claim the mark with a compare-and-swap before any other work, and
release it on every exit, including when the table is empty.

illumos has no atomic_load_32(); zio_vdev_io_start() reads the aligned
32-bit field directly.

Ported from openzfs/zfs#19263 (e2805e0, not yet merged upstream).

Signed-off-by: Kamil Monicz <kamil@monicz.dev>
---
 usr/src/uts/common/fs/zfs/ddt.c          | 9 ++++-----
 usr/src/uts/common/fs/zfs/sys/spa_impl.h | 2 +-
 usr/src/uts/common/fs/zfs/zio.c          | 2 +-
 3 files changed, 6 insertions(+), 7 deletions(-)

diff --git a/usr/src/uts/common/fs/zfs/ddt.c b/usr/src/uts/common/fs/zfs/ddt.c
index 38590e41..24754528 100644
--- a/usr/src/uts/common/fs/zfs/ddt.c
+++ b/usr/src/uts/common/fs/zfs/ddt.c
@@ -2836,12 +2836,10 @@ ddt_prune_unique_entries(spa_t *spa, zpool_ddt_prune_unit_t unit,
 		return (SET_ERROR(EINVAL));
 	}
 
-	if (spa->spa_active_ddt_prune)
+	if (atomic_cas_32(&spa->spa_active_ddt_prune, 0, 1) != 0)
 		return (SET_ERROR(EALREADY));
 	if (ddt_total_entries(spa) == 0)
-		return (0);
-
-	spa->spa_active_ddt_prune = B_TRUE;
+		goto out;
 
 	zfs_dbgmsg("prune %llu %s", (u_longlong_t)amount,
 	    unit == ZPOOL_DDT_PRUNE_PERCENTAGE ? "%" : "seconds old or older");
@@ -2879,10 +2877,11 @@ ddt_prune_unique_entries(spa_t *spa, zpool_ddt_prune_unit_t unit,
 		ddt_prune_walk(spa, cutoff, NULL);
 	}
 
+out:
 	zfs_dbgmsg("%s: prune completed in %llu ms", spa_name(spa),
 	    (u_longlong_t)NSEC2MSEC(gethrtime() - start_time));
 
-	spa->spa_active_ddt_prune = B_FALSE;
+	(void) atomic_swap_32(&spa->spa_active_ddt_prune, 0);
 	return (0);
 }
 
diff --git a/usr/src/uts/common/fs/zfs/sys/spa_impl.h b/usr/src/uts/common/fs/zfs/sys/spa_impl.h
index 839daf12..793a9eb2 100644
--- a/usr/src/uts/common/fs/zfs/sys/spa_impl.h
+++ b/usr/src/uts/common/fs/zfs/sys/spa_impl.h
@@ -290,7 +290,7 @@ struct spa {
 	 * vdev_resilver_deferred is set.
 	 */
 	boolean_t	spa_resilver_deferred;
-	boolean_t	spa_active_ddt_prune;	/* ddt prune process active */
+	uint32_t	spa_active_ddt_prune;	/* atomic prune ownership */
 	kmutex_t	spa_async_lock;		/* protect async state */
 	kthread_t	*spa_async_thread;	/* thread doing async task */
 	int		spa_async_suspended;	/* async tasks suspended */
diff --git a/usr/src/uts/common/fs/zfs/zio.c b/usr/src/uts/common/fs/zfs/zio.c
index 25cd7d52..8ad83957 100644
--- a/usr/src/uts/common/fs/zfs/zio.c
+++ b/usr/src/uts/common/fs/zfs/zio.c
@@ -3893,7 +3893,7 @@ zio_vdev_io_start(zio_t *zio)
 			 * active, cut in front of pending writers.
 			 * Ported from OpenZFS cb3c18a (#17793).
 			 */
-			if (spa->spa_active_ddt_prune)
+			if (spa->spa_active_ddt_prune != 0)
 				spa_config_enter_priority(spa, SCL_ZIO, zio,
 				    RW_READER);
 			else
-- 
